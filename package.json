{
  "name": "webhook-manager",
  "version": "0.0.1",
  "description": "Webhook manager microservices monorepo",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:api && npm run build:delivery",
    "build:api": "nest build api-service && tsc -p apps/api-service/tsconfig.migrations.json",
    "build:delivery": "nest build delivery-service && tsc -p apps/delivery-service/tsconfig.migrations.json",
    "format": "prettier --write \"{apps,libs,test}/**/*.ts\"",
    "start:api": "nest start api-service",
    "start:api:dev": "nest start api-service --watch",
    "start:api:prod": "node dist/apps/api-service/main.js",
    "start:delivery": "nest start delivery-service",
    "start:delivery:dev": "nest start delivery-service --watch",
    "start:delivery:prod": "node dist/apps/delivery-service/main.js",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm:api": "npm run build:api && typeorm -d dist/apps/api-service/database/data-source.js",
    "typeorm:delivery": "npm run build:delivery && typeorm -d dist/apps/delivery-service/database/data-source.js",
    "migration:run:api": "npm run typeorm:api -- migration:run",
    "migration:run:delivery": "npm run typeorm:delivery -- migration:run",
    "migration:run": "npm run migration:run:api && npm run migration:run:delivery",
    "migration:show:api": "npm run typeorm:api -- migration:show",
    "migration:show:delivery": "npm run typeorm:delivery -- migration:show",
    "migration:revert:api": "npm run typeorm:api -- migration:revert",
    "migration:revert:delivery": "npm run typeorm:delivery -- migration:revert"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.7",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@webhook/contracts$": "<rootDir>/libs/contracts/src/index.ts",
      "^@webhook/contracts/(.*)$": "<rootDir>/libs/contracts/src/$1"
    },
    "collectCoverageFrom": [
      "apps/**/*.ts",
      "libs/**/*.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "\\.e2e-spec\\.ts$"
    ]
  }
}
