{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@webhook/contracts$": "<rootDir>/libs/contracts/src/index.ts",
    "^@webhook/contracts/(.*)$": "<rootDir>/libs/contracts/src/$1"
  }
}
